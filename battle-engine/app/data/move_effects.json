    "effect_chance": "0..1 roll for status_effect or volatile_effect (default 1.0)",
    "volatile_effect": "confusion | attract (effect_type: status only) — session-tracked, can stack with a major status",
    "flinch_chance": "0..1 secondary roll on a damaging hit that dealt >0 damage (Bite/Stomp/Rock-slide family)",
    "no_crit": "damage roll never crits (confusion self-hit)",
    "stat_changes": "[{stat: atk|def|spa|spd|spe|acc|eva, delta, target: self|enemy}]; stat_change_chance gates the whole list",
    "recoil": "fraction of damage dealt taken by the attacker",
    "drain": "fraction of damage dealt healed by the attacker",
    "hit_range": "[min,max] hits for multi_hit (2-5 uses Gen 3 weights)",
    "always_hit": "skip the accuracy roll (Swift etc.)",
    "typeless": "no STAB, no type chart (Struggle)",
    "heal_fraction": "self-heal as a fraction of max HP"
  },

