# Shared / documentation defaults for local development.
# Copy service-specific examples into each package:
#   cp backend/.env.example backend/.env
#   cp frontend/.env.example frontend/.env
#   cp battle-engine/.env.example battle-engine/.env

# --- Backend (Node / Express) ---
# REST + Socket.IO share PORT
PORT=5000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=change_me_in_local_env
BATTLE_ENGINE_URL=http://localhost:8000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=myuser
DB_PASSWORD=mypassword
DB_NAME=pokedex
TRAINER_DB_NAME=trainer

# --- Frontend (Vite) ---
# These belong in frontend/.env (VITE_ prefix required)
# VITE_API_URL=http://localhost:5000
# Battle traffic goes through the backend /api/battle/* BFF

# --- Battle engine (Python / FastAPI) ---
# Browser calls go through backend /api/battle/*; CORS can be backend-only.
BATTLE_HOST=0.0.0.0
BATTLE_PORT=8000
CORS_ORIGINS=http://localhost:5000
BATTLE_SERVICE_URL=http://localhost:8000

# --- MySQL (docker compose) ---
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=pokedex
MYSQL_USER=myuser
MYSQL_PASSWORD=mypassword
